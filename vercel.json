{
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.bendrex.it"
        }
      ],
      "destination": "https://bendrex.it/:path*",
      "statusCode": 301
    }
  ]
}
